# ==============================================================================
# CONFIGURACIÓN NGINX PARA CENTRAL CALEFÓN CHILE (centralcalefon.cl)
# 1. Remueve .php y redirige /index.php -> /
# 2. Resuelve URLs limpias (/nosotros, /contacto)
# 3. Enruta todas las comunas y servicios a landing.php (/servicio-tecnico-calefon-las-condes)
# ==============================================================================

server {
    listen 80;
    listen [::]:80;
    server_name centralcalefon.cl www.centralcalefon.cl;

    # Redirección permanente a HTTPS
    return 301 https://centralcalefon.cl$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.centralcalefon.cl;

    # Certificados SSL de tu servidor
    # ssl_certificate /etc/letsencrypt/live/centralcalefon.cl/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/centralcalefon.cl/privkey.pem;

    return 301 https://centralcalefon.cl$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name centralcalefon.cl;

    # Ruta raíz de tu sitio en Hostinger (ajusta si es necesario)
    root /var/www/centralcalefon.cl;
    index index.php index.html;

    # Certificados SSL
    # ssl_certificate /etc/letsencrypt/live/centralcalefon.cl/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/centralcalefon.cl/privkey.pem;

    # --------------------------------------------------------------------------
    # 1. REDIRECCIÓN 301 SEO: Eliminar /index.php de la URL
    # centralcalefon.cl/index.php -> centralcalefon.cl/
    # --------------------------------------------------------------------------
    if ($request_uri ~* "^/index\.php$") {
        return 301 /;
    }

    # --------------------------------------------------------------------------
    # 2. REDIRECCIÓN 301 SEO: Eliminar extensión .php de cualquier página interna
    # centralcalefon.cl/nosotros.php -> centralcalefon.cl/nosotros
    # centralcalefon.cl/contacto.php -> centralcalefon.cl/contacto
    # --------------------------------------------------------------------------
    if ($request_uri ~* "^/([a-zA-Z0-9_-]+)\.php(\?.*)?$") {
        return 301 /$1$2;
    }

    # --------------------------------------------------------------------------
    # 3. ENRUTAMIENTO PRINCIPAL (try_files):
    # - Si el archivo estático existe (imagen, css, video, js), lo sirve.
    # - Si es un archivo .php (ej. /nosotros busca nosotros.php), lo ejecuta.
    # - Si no existe, lo pasa a landing.php para comunas y servicios dinámicos.
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri/ $uri.php /landing.php?$args;
    }

    # --------------------------------------------------------------------------
    # 4. PROCESAMIENTO PHP (PHP-FPM)
    # --------------------------------------------------------------------------
    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_split_path_info ^(.+\.php)(/.+)$;

        # Socket PHP-FPM (según la versión instalada en tu Hostinger VPS, ej. 8.3, 8.2 u 8.1):
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
        # fastcgi_pass unix:/var/run/php/php8.2-fpm.sock;
        # fastcgi_pass 127.0.0.1:9000;

        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        fastcgi_buffer_size 128k;
        fastcgi_buffers 256 16k;
        fastcgi_busy_buffers_size 256k;
    }

    # --------------------------------------------------------------------------
    # 5. CACHÉ Y COMPRESIÓN DE ASSETS
    # --------------------------------------------------------------------------
    location ~* \.(jpg|jpeg|png|gif|webp|svg|ico|mp4|webm|woff2|woff|ttf|css|js)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    # Bloquear acceso a archivos sensibles
    location ~ /\.(git|ht|env) {
        deny all;
        access_log off;
        log_not_found off;
    }
}
